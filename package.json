  "description": "Decentralized pay-per-call AI API proxy gateway using Hedera x402 micropayments, Chainlink CRE TEE, and Bazantic MCP",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server/src/index.js",
    "dev": "ts-node server/src/index.ts",
    "agent": "ts-node agent/client.ts",
    "mcp": "ts-node bazantic/mcp-server.ts",
    "simulate:cre": "bash cre/simulate.sh",
    "test": "ts-node test/e2e.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@hashgraph/sdk": "^2.55.0",

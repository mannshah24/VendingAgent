# ==========================================
# VendingAgent – Environment Variables
# Copy this file to .env and fill in values
# ==========================================

# ---- Server ----
PORT=3000
NODE_ENV=development
SERVER_BASE_URL=http://localhost:3000

# ---- Hedera Testnet (Merchant / Gateway account) ----
# Get a free testnet account at: https://portal.hedera.com/
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.XXXXXXX
HEDERA_OPERATOR_PRIVATE_KEY=302e020100300506032b657004220420...

# ---- Hedera x402 Payment Settings ----
# Price per API call in HBAR (smallest unit = tinybar; 1 HBAR = 100,000,000 tinybars)
X402_PRICE_HBAR=0.5
X402_MERCHANT_ACCOUNT_ID=0.0.XXXXXXX
# Blocky402 Facilitator URL (Hedera testnet)
BLOCKY402_FACILITATOR_URL=https://api.blocky402.com/v1

# ---- Agent Consumer Wallet (separate from merchant) ----
AGENT_HEDERA_ACCOUNT_ID=0.0.YYYYYYY
AGENT_HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...

# ---- Chainlink CRE ----
# These are injected as encrypted secrets into the TEE at runtime
CRE_WORKFLOW_NAME=vending-agent-confidential
CRE_SECRETS_PASSPHRASE=change-me-before-production

# ---- Upstream Premium API (secret kept INSIDE CRE TEE) ----
# This key is NEVER exposed to the server directly — only to the enclave
UPSTREAM_API_KEY=your-alphavantage-or-coingecko-api-key
UPSTREAM_API_BASE_URL=https://www.alphavantage.co/query

# ---- Bazantic / MCP ----
BAZANTIC_GATEWAY_URL=https://gateway.bazantic.com
BAZANTIC_API_KEY=your-bazantic-api-key
MCP_SERVER_PORT=3001
